{
  "name": "Backoffice Printing",
  "install": "bash .cursor/install.sh",
  "terminals": [
    {
      "name": "backend",
      "command": ". venv/bin/activate && DEBUG=true uvicorn backend.app.main:app --host 0.0.0.0 --port 7474 --loop asyncio"
    },
    {
      "name": "frontend",
      "command": "npm run dev --prefix frontend"
    }
  ],
  "ports": [
    { "name": "backend", "port": 7474 },
    { "name": "frontend", "port": 5173 }
  ]
}
